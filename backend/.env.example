# Copy to .env and fill in
PORT=5000
# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/quran_ai
# Or MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/quran_ai
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# Seeded admin account (npm run seed)
ADMIN_EMAIL=admin@quranai.uz
ADMIN_PASSWORD=admin12345
